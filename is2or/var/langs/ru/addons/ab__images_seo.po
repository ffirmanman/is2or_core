msgctxt "Languages::ab__is.image_number"
msgid "Image number<br/><code>[image_num]</code>"
msgstr "Номер изображения<br/><code>[image_num]</code>"

msgctxt "Languages::ab__is.image_number.tooltip"
msgid "This design will be used to substitute instead of the <code>[image_num]</code> placeholder in image attribute values, starting from second image. <br/>For the first image this placeholder will be cut"
msgstr "Данная конструкция будет использована для подстановки вместо плейсхолдера <code>[image_num]</code> в значениях атрибутов изображений, начиная со второго."
"<br/>Для первого изображения этот плейсхолдер будет вырезан"

msgctxt "Languages::ab__is.image_number.default"
msgid ", [n] image"
msgstr ", изображение [n]"

msgctxt "Languages::ab__is.image_number.hint"
msgid "where [n] is the image number "
msgstr "где [n] — номер изображения"

msgctxt "Languages::ab__is.placeholders_list"
msgid "The following placeholders are also available:<br/> <code>[text]</code> - name [object]"
msgstr "Вам также доступны следующие плейсхолдеры:<br/>"
"<code>[text]</code> - название [object]"

msgctxt "Languages::ab__is.placeholders_list.P"
msgid "of the product"
msgstr "товара"

msgctxt "Languages::ab__is.placeholders_list.C"
msgid "of the category"
msgstr "категории"

msgctxt "Languages::ab__is.placeholders_list.F"
msgid "of the feature variant"
msgstr "варианта характеристики"

msgctxt "Languages::ab__is.placeholders_list.empty"
msgid "You need to fill in the required fields and click the \"Save\" button. Otherwise, the add-on will not work on the storefront"
msgstr "Вам необходимо заполнить нужные поля и нажать кнопку \"Сохранить\". Иначе модуль не будет работать на витрине"

msgctxt "Languages::privilege_groups.ab__images_seo"
