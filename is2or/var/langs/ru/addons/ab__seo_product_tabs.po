msgstr "HTML-тег заголовка вкладки"

msgctxt "Languages::ab__spt.product_tabs.tab_header.tabs_enabled.N"
msgid "Tab header"
msgstr "Заголовок вкладки"

msgctxt "Languages::ab__spt.product_tabs.tab_header.tabs_enabled.Y"
