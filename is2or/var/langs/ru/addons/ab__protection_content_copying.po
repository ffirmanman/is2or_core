msgctxt "Addons::name::ab__protection_content_copying"
msgid "AB: Protection from the content copying"
msgstr "AB: Защита от копирования"

msgctxt "Addons::description::ab__protection_content_copying"
msgid "Protect your content from selection and copy"
msgstr "Модуль защищает контент от выделения и копирования"

msgctxt "Languages::ab__protection_content_copying"
msgid "AB: Protection from the content copying"
msgstr "AB: Защита от копирования"

msgctxt "SettingsOptions::ab__protection_content_copying::activate_non_protection_for_ips"
msgid "Disable copying for specified IP addresses"
msgstr "Отключить копирование для указанных IP-адресов"

msgctxt "SettingsTooltips::ab__protection_content_copying::activate_non_protection_for_ips"
msgid "Block of the copy will be disabled for the IP addresses specified in the field below"
msgstr "Для IP-адресов, указанных в поле ниже, будет отключено блокирование копирования"

msgctxt "SettingsOptions::ab__protection_content_copying::non_protection_for_ips"
msgid "IP addresses list (specify from a new line)"
msgstr "Список IP-адресов (указывать с новой строки)"

msgctxt "SettingsTooltips::ab__protection_content_copying::non_protection_for_ips"
msgid "The addresses list must be specified from a new line, for example: <code>127.0.0.1</code><br/> <code>127.0.0.2</code>"
msgstr "Список адресов нужно указывать с новой строки, например:"
"<code>127.0.0.1</code><br/>"
"<code>127.0.0.2</code>"

msgctxt "SettingsOptions::ab__protection_content_copying::non_protection_classes"
msgid "Do not distribute the lock on data classes"
msgstr "Не распространять блокировку на данные классы"

msgctxt "SettingsTooltips::ab__protection_content_copying::non_protection_classes"
msgid "You can list the css-classes of elements that will not be covered by the lock (separated by commas)"
msgstr "Вы можете перечислить css-классы элементов на которые не будет распространяться блокировка (через запятую)"

msgctxt "SettingsOptions::ab__protection_content_copying::non_protection_for_admin"
msgid "Disable admin lock"
msgstr "Отключить блокировку для администратора"

msgctxt "SettingsTooltips::ab__protection_content_copying::non_protection_for_admin"
msgid "Disable blocking of content copying for store administrators and vendors"
msgstr "Отключить блокировку от копирования контента для администраторов и продавцов магазина"

msgctxt "Languages::ab__pcc.status"
msgid "Disable AB: Protection from the content copying"
msgstr "Отключить AB: Защита от копирования"

msgctxt "Languages::ab__pcc.settings"
msgid "Common settings"
msgstr "Общие настройки"

msgctxt "Languages::ab__pcc.help"
msgid "Help"
msgstr "Справка"

msgctxt "Languages::ab__pcc.help.doc"
msgid "Read the <a target='_blank' href='https://cs-cart.alexbranding.com/en/ab__protection_content_copying.doc'>documentation</a>."
msgstr "Ознакомиться с <a target='_blank' href='https://cs-cart.alexbranding.com/ru/ab__protection_content_copying.doc'>документацией</a>."

