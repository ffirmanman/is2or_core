msgctxt "Languages::ab__emd.placeholders.min_price"
msgid "<b>[min_price]</b> — minimal product price in the section (as is, by currency settings)<br> <b>[min_price_nocurrency]</b> — minimal product price in the section (without currency sign)<br> <b>[min_price_noseparate]</b> — minimal product price in the section (without thousand separator)<br> <b>[min_price_noseparate_nocurrency]</b> — minimal product price in the section (without thousand separator and currency sign)<br> <b>[min_price_prefix]</b> — value of the language variable <code>ab__em.min_price_prefix</code>. Prints when minimal product price greater than 0 only. Can be changed by translations<br> <b>[min_price_suffix]</b> — value of the language variable <code>ab__em.min_price_suffix</code>. Prints when minimal product price greater than 0 only. Can be changed by translations"
msgstr "<b>[min_price]</b> — минимальная цена товара в разделе (как есть, по настройкам валюты)<br>"
"<b>[min_price_nocurrency]</b> — минимальная цена товара в разделе (без валюты)<br>"
"<b>[min_price_noseparate]</b> — минимальная цена товара в разделе (без тысячного разделителя)<br>"
"<b>[min_price_noseparate_nocurrency]</b> — минимальная цена товара в разделе (без тысячного разделителя и без валюты)<br>"
"<b>[min_price_prefix]</b> — значение языковой переменной <code>ab__em.min_price_prefix</code>. Отображается только если минимальная цена выше нуля. Может быть изменена в переводах<br>"
"<b>[min_price_suffix]</b> — значение языковой переменной <code>ab__em.min_price_suffix</code>. Отображается только если минимальная цена выше нуля. Может быть изменена в переводах"

msgctxt "Languages::ab__emd.placeholders.max_price"
msgid "<b>[max_price]</b> — maximal product price in the section (as is, by currency settings)<br> <b>[max_price_nocurrency]</b> — maximal product price in the section (without currency sign)<br> <b>[max_price_noseparate]</b> — maximal product price in the section (without thousand separator)<br> <b>[max_price_noseparate_nocurrency]</b> — maximal product price in the section (without thousand separator and currency sign)<br> <b>[max_price_prefix]</b> — value of the language variable <code>ab__em.max_price_prefix</code>. Prints when maximal product price greater than 0 only. Can be changed by translations<br> <b>[max_price_suffix]</b> — value of the language variable <code>ab__em.max_price_suffix</code>. Prints when maximal product price greater than 0 only. Can be changed by translations"
msgstr "<b>[max_price]</b> — максимальная цена товара в разделе (как есть, по настройкам валюты)<br>"
"<b>[max_price_nocurrency]</b> — максимальная цена товара в разделе (без валюты)<br>"
"<b>[max_price_noseparate]</b> — максимальная цена товара в разделе (без тысячного разделителя)<br>"
"<b>[max_price_noseparate_nocurrency]</b> — максимальная цена товара в разделе (без тысячного разделителя и без валюты)<br>"
"<b>[max_price_prefix]</b> — значение языковой переменной <code>ab__em.max_price_prefix</code>. Отображается только если максимальная цена выше нуля. Может быть изменена в переводах<br>"
"<b>[max_price_suffix]</b> — значение языковой переменной <code>ab__em.max_price_suffix</code>. Отображается только если максимальная цена выше нуля. Может быть изменена в переводах"

