msgid "Allow multiple descriptions"
msgstr "Разрешить мультиописания"

msgctxt "SettingsTooltips::ab__seo_filters::enable_multiple_descriptions"
msgid "For multiple descriptions work, need an active module <a target='_blank' href='https://cs-cart.alexbranding.com/en/category-multi-descriptions.html'>\"AB: Multiple category descriptions + FAQ\"</a> version 2.0 and higher"
msgstr "Для работы мультиописаний требуется наличие активного модуля <a target='_blank' href='https://cs-cart.alexbranding.com/ru/multiple-categories-descriptions.html'>\"AB: Мультиописания категорий + ЧАВО\"</a> версии 2.0 и выше"

