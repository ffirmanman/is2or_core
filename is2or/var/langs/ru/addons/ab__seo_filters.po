msgid "permit (open in the current window)"
msgstr "разрешить (открывать в текущем окне)"

msgctxt "SettingsVariants::ab__seo_filters::feature_as_seo_page::allow_in_new_window"
msgid "permit (open in the new window)"
msgstr "разрешить (открывать в новом окне)"

msgctxt "SettingsOptions::ab__seo_filters::hide_description_on_hashs_pages"
msgid "Hide descriptions on filters pages for which SEO pages weren't created"
msgstr "Скрывать описания на страницах фильтров, для которых не были созданы SEO-страницы"

msgctxt "SettingsTooltips::ab__seo_filters::hide_description_on_hashs_pages"
msgid "If the category has a description, if there is a transition to the filter page for which SEO page hasn't exist — the category description won't be displayed"
msgstr "Если у категории есть описание, то при переходе на страницу фильтра, для которой не существует соответствующей SEO-страницы — описание категории не будет отображено"

