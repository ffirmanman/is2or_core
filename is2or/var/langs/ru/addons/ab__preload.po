msgctxt "Languages::abt__ut2.settings.addons.ab__preload_group"
msgid "Add-on \"AB: Preload\""
msgstr "Модуль \"AB: Preload (Предварительная загрузка)\""

msgctxt "Languages::abt__ut2.settings.addons.ab__preload_group_description"
msgid "Disables Lazy Load for several first images and adds tags <code>&#60;link rel=\"preload\"></code> for them. Use it to increase performance of PageSpeed Insights. <b>To get maximal efficiency, you shall preload images that are displayed at a moment of the first page loading only.</b>"
msgstr "Отключает Lazy Load для нескольких первых изображений и добавляет для них теги <code>&#60;link rel=\"preload\"></code>. Используйте для повышения показателя PageSpeed Insights. <b>Для максимальной эффективности предзагружайте только те изображения, которые видны в момент первой загрузки страницы.</b>"

