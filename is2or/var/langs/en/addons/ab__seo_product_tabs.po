msgctxt "Languages::ab__spt.product_tabs.add_tab_to_floating_panel"
msgid "Show tab on the floating panel"
msgstr "Show tab on the floating panel"

msgctxt "Languages::ab__spt.product_tabs.add_tab_to_floating_panel.why_disabled"
msgid "You can activate this setting under the following conditions: <ul> <li>The setting \"Display product details in tabs\" in <a href=\"[link_1]\" target=\"_blank\">appearance settings</a> - should be disabled. Current status - [settings_1_status]</li> <li>The add-on <a href=\"[link_2]\" target=\"_blank\">AB: SEO for product tabs</a> settings \"Add navigation bar with tab links on the product page\" - should be enabled. Current status - [settings_2_status]</li> <li>The setting \"Show this tab in a popup window\", located in this window in the tab \"General\" - should be disabled. Current status - [settings_3_status]</li> </ul>"
msgstr "You can activate this setting under the following conditions:"
"<ul>"
"<li>The setting \"Display product details in tabs\" in <a href=\"[link_1]\" target=\"_blank\">appearance settings</a> - should be disabled. Current status - [settings_1_status]</li>"
"<li>The add-on <a href=\"[link_2]\" target=\"_blank\">AB: SEO for product tabs</a> settings \"Add navigation bar with tab links on the product page\" - should be enabled. Current status - [settings_2_status]</li>"
"<li>The setting \"Show this tab in a popup window\", located in this window in the tab \"General\" - should be disabled. Current status - [settings_3_status]</li>"
"</ul>"

