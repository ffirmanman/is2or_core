msgctxt "SettingsOptions::ab__seo_filters::add_slash"
msgid "Add the finishing slash '/'"
msgstr "Додати завершальний слеш '/'"

msgctxt "SettingsTooltips::ab__seo_filters::add_slash"
msgid "Depending on your SEO link generation scheme, allow adding the finishing slash '/' in the link when changing the link to the SEO page (Checkbox: Redirect from the old URL)"
msgstr "В залежності від Вашої схеми формування SEO-посилань, дозволити додання завершального слешу '/' до посилання при зміні посилання на SEO-сторінку (Checkbox: Перенаправляти зі старого URL)"

msgctxt "SettingsOptions::ab__seo_filters::block_id"
msgid "ID block"
msgstr "Блок ID"

