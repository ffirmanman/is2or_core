msgstr "Загальні"

msgctxt "SettingsOptions::ab__advanced_sitemap::cron_key"
msgid "Cron-key"
msgstr "Cron-ключ"

msgctxt "SettingsTooltips::ab__advanced_sitemap::cron_key"
msgid "Auto update requires key. Length must be between 10 and 20 chars (only latin letters and digits)"
msgstr "Для автоматичного виконання оновлення, наявність ключа обов'язкова. Довжина має бути в межах від 10 до 20 символів (лише латинські букви і цифри)"

msgctxt "SettingsOptions::ab__advanced_sitemap::exclude_categories"
msgid "Exclude categories"
msgstr "Вилучити категорії"

msgctxt "SettingsTooltips::ab__advanced_sitemap::exclude_categories"
msgid "Exclude categories from sitemaps:<br><ul> <li>don't exclude — show all categories</li> <li>without products — categories without products</li> <li>with products without amount — categories in which all products don't have amount</li> <li>with products without prices — categories in which all products don't have prices</li> <li>with products without amount and prices — categories in which all products don't have amount and prices</li> </ul>"
msgstr "Вилучати категорії з карт сайту:<br><ul>"
" <li>не вилучати — відображати всі категорії</li>"
" <li>без товарів — категорії, що не мають товарів</li>"
" <li>з товарами без наявності — категорії, у яких всі товари не мають наявності</li>"
" <li>з товарами без цін — категорії, у яких всі товари не мають цін</li>"
" <li>з товарами без цін і наявності — категорії, у яких всі товари не мають ні цін, ні наявності</li>"
" </ul>"

msgctxt "SettingsVariants::ab__advanced_sitemap::exclude_categories::none"
msgid "don't exclude"
msgstr "не вилучати"

msgctxt "SettingsVariants::ab__advanced_sitemap::exclude_categories::without_products"
msgid "without products"
msgstr "без товарів"

msgctxt "SettingsVariants::ab__advanced_sitemap::exclude_categories::without_product_amount"
msgid "with products without amount"
msgstr "з товарами без наявності"

msgctxt "SettingsVariants::ab__advanced_sitemap::exclude_categories::without_product_price"
msgid "with products without prices"
msgstr "з товарами без цін"

msgctxt "SettingsVariants::ab__advanced_sitemap::exclude_categories::without_product_amount_and_price"
msgid "with products without amount and prices"
msgstr "з товарами без цін і наявності"

msgctxt "SettingsOptions::ab__advanced_sitemap::exclude_brands"
msgid "Exclude brands"
msgstr "Вилучити бренди"

msgctxt "SettingsTooltips::ab__advanced_sitemap::exclude_brands"
msgid "Exclude brands from sitemaps:<br><ul> <li>don't exclude — show all brands</li> <li>without products — brands without products</li> <li>with products without amount — brands in which all products don't have amount</li> <li>with products without prices — brands in which all products don't have prices</li> <li>with products without amount and prices — brands in which all products have neither amount nor prices</li> </ul>"
msgstr "Вилучати бренди з карт сайту:<br><ul>"
" <li>не вилучати — відображати всі бренди</li>"
" <li>без товарів — бренди, що не мають товарів</li>"
" <li>з товарами без наявності — бренди, у яких всі товари не мають наявності</li>"
" <li>з товарами без цін — бренди, у яких всі товари не мають цін</li>"
" <li>з товарами без цін і наявності — бренди, у яких всі товари не мають ні цін, ні наявності</li>"
" </ul>"

