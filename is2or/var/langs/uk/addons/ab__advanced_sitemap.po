msgctxt "SettingsTooltips::ab__advanced_sitemap::add_title_and_caption"
msgid "Setting depends on the add-on \"AB: Automatic Alt and Title tags for images using templates\""
msgstr "Налаштування залежить від модулю \"АВ: Автоматичні теги Alt і Title для зображень по шаблонам\""

msgctxt "SettingsOptions::ab__advanced_sitemap::add_variation_features_description"
msgid "Add feature values that will be used for creation of variation at <code>&lt;image:title&gt;</code> and <code>&lt;image:caption&gt;</code>"
msgstr "Додати значення характеристик, по яким створено варіацію в <code>&lt;image:title&gt;</code> та <code>&lt;image:caption&gt;</code>"

msgctxt "SettingsTooltips::ab__advanced_sitemap::add_variation_features_description"
msgid "Setting depends on add-ons \"AB: Automatic Alt and Title tags for images using templates\" and \"Product variations\".<br/> Pay attention! When the setting is active, time of sitemap generation will be increased that tends to increase demands to hardware of your server"
msgstr "Налаштування залежить від модулів \"АВ: Автогенерація атрибутів Alt і Title для зображень\" і \"Варіації товарів\".,br/>"
"Зверніть увагу, що при увімкнені цього налаштування збільшиться час генерації карти сайту, що призведе до збільшення вимог до апаратного забезпечення Вашого сервера"

