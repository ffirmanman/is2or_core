msgctxt "Languages::ab__emd.placeholders.product_features"
msgid "<b>[some {fvalue_ID} text]</b> — text with a feature value, where ID — is the feature identifier, \"some text\" — any text (optional) that will be inserted only if product has the value of the corresponding feature<br> <b>[some {fname_ID} text]</b> — text with a feature name, where ID — is the feature identifier, \"some text\" — any text (optional) that will be inserted only if product has the value of the corresponding feature"
msgstr "<b>[довільний {fvalue_ID} текст]</b> — текст зі значенням характеристики, де ID — ідентифікатор обраної характеристики, \"довільний текст\" — будь-який (не обов'язковий) текст, що буде відображено лише якщо товару проставлено значення відповідної характеристики<br>"
