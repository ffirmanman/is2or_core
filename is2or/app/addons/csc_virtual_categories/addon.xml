	<default_language>en</default_language>	
    <auto_install>MULTIVENDOR,ULTIMATE</auto_install>
	<supplier>cs-commerce.com</supplier>
	<supplier_link>https://www.cs-commerce.com</supplier_link>	
	<has_icon>true</has_icon>
	<marketplace_product_id>2853</marketplace_product_id>
	<compatibility>       
        <core_version>
            <min>4.3.1</min>
        </core_version>
    </compatibility>
	<authors>
       <author>
           <name>CS-Commerce Software Solutions</name>
           <email>info@cs-commerce.com</email>
           <url>https://www.cs-commerce.com</url>
       </author>
   </authors>
   <settings edition_type="ROOT,ULT:VENDOR">
		<sections>
		<section id="general">
			<name>General</name>
			<items>
				<item id="sys">					
					<type>header</type>							
				</item>
			</items>
		</section>
		</sections>
	</settings> 
	
	<queries>
		<item for="install">
			CREATE TABLE IF NOT EXISTS `?:csc_virtual_categories` (
				`name` varchar(255) COLLATE 'utf8_general_ci' NOT NULL,
				`company_id` mediumint(8) NOT NULL DEFAULT '0',
				`value` varchar(255) COLLATE 'utf8_general_ci' NOT NULL DEFAULT '',
				UNIQUE (`name`, `company_id`)
			 ) ENGINE='InnoDB' COLLATE 'utf8_general_ci';
		</item>		
		<item for="uninstall">
			DROP TABLE IF EXISTS `?:csc_virtual_categories`;	
		</item>	
		<item>
			CREATE TABLE IF NOT EXISTS `?:csc_virtual_categories_conditions` (
			  `category_id` mediumint(8) NOT NULL DEFAULT '0',
			  `is_virtual` char(1) NOT NULL DEFAULT 'N',
			  `conditions` text NOT NULL,
			  PRIMARY KEY (`category_id`)
			) ENGINE=MyISAM DEFAULT CHARSET=utf8;
		</item>		
		<item for="uninstall">DROP TABLE IF EXISTS `?:csc_virtual_categories_conditions`;</item>
	</queries>
	<functions>
        <item for="install">fn_csc_virtual_categories_install</item>        
        <item for="uninstall">fn_csc_virtual_categories_uninstall</item>
    </functions>	
</addon>