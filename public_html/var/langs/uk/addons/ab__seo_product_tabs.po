msgid "AB:"
msgstr "AB:"

msgctxt "SettingsOptions::ab__seo_product_tabs::add_tabs_fixed_panel"
msgid "Add navigation bar with tab links on the product page"
msgstr "Додати навігаційну панель вкладок на сторінці товару"

msgctxt "SettingsTooltips::ab__seo_product_tabs::add_tabs_fixed_panel"
msgid "When the setting is enabled a tabbed floating panel will be added for easy navigation on the page"
msgstr "При активному налаштуванні буде додана плаваюча панель для швидкої навігації по обраним вкладкам товару"

msgctxt "SettingsOptions::ab__seo_product_tabs::tabs_fixed_panel_position"
msgid "Tab floating panel position"
msgstr "Позиція навігаційної панелі вкладок"

msgctxt "SettingsTooltips::ab__seo_product_tabs::tabs_fixed_panel_position"
msgid "Determines where the tab navigation bar will be displayed"
msgstr "Визначає місце, де буде виведена навігаційна панель вкладок"

msgctxt "SettingsVariants::ab__seo_product_tabs::tabs_fixed_panel_position::before_tabs"
