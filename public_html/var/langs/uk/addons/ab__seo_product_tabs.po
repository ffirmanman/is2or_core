msgctxt "Addons::name::ab__seo_product_tabs"
msgid "AB: SEO for product tabs"
msgstr "AB: SEO для товарних вкладок"

msgctxt "Addons::description::ab__seo_product_tabs"
msgid "This add-on allows to add SEO optimized headers for product tabs on the product pages. It is possible to use templates and placeholders of product names"
msgstr "Модуль дозволяє додавати на сторінках товарів SEO оптимізовані заголовки товарних вкладок з використанням шаблонів і плейсхолдера назви товару"

msgctxt "Languages::ab__seo_product_tabs"
msgid "AB: SEO for product tabs"
msgstr "AB: SEO для товарних вкладок"

