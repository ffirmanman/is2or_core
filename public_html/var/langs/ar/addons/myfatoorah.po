msgid "text_insert_card"
msgstr "إدخال بيانات البطاقة"

msgctxt "Languages::text_holder_name"
msgid "text_holder_name"
msgstr "اسم صاحب البطاقة"

msgctxt "Languages::text_card_number"
msgid "text_card_number"
msgstr "رقم البطاقة"

msgctxt "Languages::text_expire_date"
msgid "text_expire_date"
msgstr "YY / MM"

msgctxt "Languages::text_cvv"
msgid "text_cvv"
msgstr "CVV"

msgctxt "Languages::text_myfatoorah_disabled"
msgid "text_myfatoorah_disabled"
msgstr "تم إيقاف إضافة ماي فاتورة"

msgctxt "Languages::text_ap_disabled"
msgid "text_ap_disabled"
msgstr "تم إيقاف زر أبل باي"

msgctxt "Languages::text_ap_with_list_option"
msgid "text_ap_with_list_option"
msgstr "لتفعيل زر أبل باي يجب اختيار 'سرد جميع طرق الدفع المفعلة في صفحة الدفع' من 'قائمة خيارات الدفع'."

msgctxt "Languages::text_installation_warning"
msgid "text_installation_warning"
msgstr "لتفعيل ماي فاتورة يجب عليك ضبط الإعدادت أولاً."
