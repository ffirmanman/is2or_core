msgctxt "Languages::ab__sdff.ab__pfe_extending.var"
msgid "<div style='padding:0 10px;'>Use <code>{$product.feature_short_desc}</code> in product description block to display its short description from features</div>"
msgstr "<div style='padding:0 10px;'>Используйте <code>{$product.feature_short_desc}</code> "
"в блоке описания товара для отображения его краткого описания из характеристик</div>"

msgctxt "Languages::ab__sdff.ab__pfe_extending.override_all"
msgid "<div style='padding:0 10px;'><code>{$product.short_description}</code> is replaced to short description from features for all products. Also you can use variable <code>{$product.feature_short_desc}</code></div>"
msgstr "<div style='padding:0 10px;'><code>{$product.short_description}</code> "
"заменено на краткое описание из характеристик для всех товаров. "
"Также Вы можете использовать переменную "
"<code>{$product.feature_short_desc}</code></div>"

msgctxt "Languages::ab__sdff.ab__pfe_extending.override_empty"
msgid "<div style='padding:0 10px;'><code>{$product.short_description}</code> is replaced to short description from features only where it's empty. Also you can use variable <code>{$product.feature_short_desc}</code></div>"
msgstr "<div style='padding:0 10px;'><code>{$product.short_description}</code> заменено "
"на краткое описание из характеристик для всех товаров с пустым кратким "
"описанием. Также Вы можете использовать переменную "
"<code>{$product.feature_short_desc}</code></div>"

