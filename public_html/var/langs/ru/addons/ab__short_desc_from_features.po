msgctxt "Addons::name::ab__short_desc_from_features"
msgid "AB: Products short description from features"
msgstr "AB: Краткое описание товара из характеристик"

msgctxt "Addons::description::ab__short_desc_from_features"
msgid "Add-on generates products short descriptions from its chosen features"
msgstr "Модуль формирует краткие описания для товаров по их выбранным характеристикам"

msgctxt "Languages::ab__short_desc_from_features"
msgid "AB: Products short description from features"
msgstr "AB: Краткое описание товара из характеристик"

msgctxt "SettingsOptions::ab__short_desc_from_features::show_descr_in_multicolumn"
msgid "Display a short description in the \"Grid\" view list"
msgstr "Отображать краткое описание в списке вида \"Сетка\""

msgctxt "SettingsTooltips::ab__short_desc_from_features::show_descr_in_multicolumn"
msgid "When the setting is active, a product short description will be displayed in the product lists"
msgstr "Когда настройка активна, в списках товаров будет отображено краткое описание товара"

msgctxt "SettingsOptions::ab__short_desc_from_features::cron_key"
msgid "Cron key"
msgstr "Cron ключ"

msgctxt "SettingsTooltips::ab__short_desc_from_features::cron_key"
msgid "Auto update requires Cron key. Length must be between 10 and 20 chars (only latin letters and numbers)"
msgstr "Автоматическое обновление требует Cron ключ. "
"Длина ключа должна находится в пределах 10-20 символов (только латинские буквы и цифры)"

msgctxt "SettingsOptions::ab__short_desc_from_features::insert_type"
msgid "Short description override order"
msgstr "Взаимодействие с кратким описанием"

msgctxt "SettingsTooltips::ab__short_desc_from_features::insert_type"
msgid "Also you can use variable <code>$feature_short_desc</code>. Note that the \"overwrite\" mode does not replace the already existing product short description but only replaces the value when displaying on the storefront."
msgstr "Также Вы можете использовать переменную <code>$feature_short_desc</code>. "
"Также обратите внимание, что режим \"перезаписать\" не заменяет "
"уже существующее краткое описание для товаров, а лишь "
"подменяет значение при отображении на клиентской стороне."

msgctxt "SettingsVariants::ab__short_desc_from_features::insert_type::var"
msgid "Don`t override $short_description"
msgstr "Не перезаписывать $short_description"

msgctxt "SettingsVariants::ab__short_desc_from_features::insert_type::override_all"
msgid "Override $short_description for all products"
msgstr "Перезаписать $short_description для всех товаров"

msgctxt "SettingsVariants::ab__short_desc_from_features::insert_type::override_empty"
msgid "Override $short_description only if it's empty"
msgstr "Перезаписать $short_description только если оно пусто"

