<?xml version="1.0"?>
<addon scheme="3.0">
    <id>is2or_ai_integration</id>
    <version>1.0</version>
    <priority>6010</priority>
    <position>1</position>
    <default_language>en</default_language>
    <auto_install>MULTIVENDOR</auto_install>
    <status>active</status>
    <has_icon>Y</has_icon>
    <name>IS2OR: AI Integration</name>
    <description>Replaces the default CS-Cart storefront search with semantic AI-powered search. Falls back to native CS-Cart search automatically when the AI service is unavailable or returns no results.</description>
    <supplier>IS2OR</supplier>

    <settings>
        <sections>
            <section id="general">
                <items>
                    <item id="api_base_url">
                        <type>input</type>
                        <default_value></default_value>
                    </item>
                    <item id="api_token">
                        <type>input</type>
                        <default_value></default_value>
                    </item>
                    <item id="search_limit">
                        <type>input</type>
                        <default_value>10</default_value>
                    </item>
                    <item id="listing_timeout">
                        <type>input</type>
                        <default_value>20</default_value>
                    </item>
                    <item id="debug_mode">
                        <type>checkbox</type>
                        <default_value>N</default_value>
                    </item>
                </items>
            </section>
        </sections>
    </settings>
</addon>
