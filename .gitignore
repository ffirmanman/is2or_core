# Ignore sensitive staging configuration files
is2or/config.local.php
is2or/local_conf.php
is2or/local_conf_2.php

# Ignore all staging log files
is2or/*.log
is2or/error_log*

# Ignore temporary directories, cache, and automatic backup files
is2or/var/cache/
is2or/var/compiled/
is2or/var/snapshots/
is2or/var/backups/
is2or/var/upgrade/
is2or/upgrades/
is2or/tmp/
is2or/__MACOSX/

# Ignore all media files and product images to keep the repository lightweight
is2or/images/
is2or/design/themes/*/media/

# Ignore digital downloads and user-uploaded files
is2or/var/downloads/
is2or/var/attachments/
is2or/var/custom_files/

# Ignore old archive files and server-generated temporary files
is2or/*.zip
is2or/*.tar.gz
is2or/*.gz

# Ignore operating system, IDE, and temporary backup files
.DS_Store
Thumbs.db
backup_addon_git_staging/
html/
